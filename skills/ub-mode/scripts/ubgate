#!/bin/sh
# ubgate launcher for the ub-mode skill. Finds or installs the ubgate binary,
# then runs it with every argument unchanged:
#
#   1. $UBGATE_BIN, when set
#   2. ubgate on PATH
#   3. the cache: ${XDG_CACHE_HOME:-$HOME/.cache}/ubgate/<version>/ubgate
#   4. the GitHub release asset for this OS/arch, checked against SHA256SUMS
#   5. go install .../cmd/ubgate@<version> into the cache directory
#
# Exit 127 when none of them yields a binary; otherwise ubgate's own status.
set -eu

# The one place the ubgate version is pinned. A release tag must match it.
UBGATE_VERSION=v0.1.0
UBGATE_REPO=matheusAle/ub-mode
UBGATE_MODULE=github.com/matheusAle/ub-mode/ubgate/cmd/ubgate
# Overridable for mirrors (and for testing against a local release dir).
UBGATE_RELEASE_URL=${UBGATE_RELEASE_URL:-https://github.com/$UBGATE_REPO/releases/download}

say() { printf 'ubgate launcher: %s\n' "$*" >&2; }
die() {
	say "$*"
	exit 127
}

if [ -n "${UBGATE_BIN:-}" ]; then
	[ -f "$UBGATE_BIN" ] && [ -x "$UBGATE_BIN" ] || die "UBGATE_BIN=$UBGATE_BIN is not an executable file"
	exec "$UBGATE_BIN" "$@"
fi

# UBGATE_LAUNCHER stops a launcher that is itself on PATH as "ubgate" from
# calling itself forever.
if [ -z "${UBGATE_LAUNCHER:-}" ] && path_bin=$(command -v ubgate 2>/dev/null); then
	UBGATE_LAUNCHER=1
	export UBGATE_LAUNCHER
	exec "$path_bin" "$@"
fi

os=
case $(uname -s) in
Darwin) os=darwin ;;
Linux) os=linux ;;
esac
arch=
case $(uname -m) in
x86_64 | amd64) arch=amd64 ;;
arm64 | aarch64) arch=arm64 ;;
esac
[ -n "${XDG_CACHE_HOME:-}" ] || [ -n "${HOME:-}" ] || die "set HOME or XDG_CACHE_HOME (cache location)"
cache_dir=${XDG_CACHE_HOME:-$HOME/.cache}/ubgate/$UBGATE_VERSION
bin=$cache_dir/ubgate

if [ -x "$bin" ]; then
	exec "$bin" "$@"
fi

fetch() { # fetch URL FILE
	if command -v curl >/dev/null 2>&1; then
		curl -fsSL --retry 2 -o "$2" "$1"
	elif command -v wget >/dev/null 2>&1; then
		wget -q -O "$2" "$1"
	else
		say "neither curl nor wget is installed"
		return 1
	fi
}

sha256_of() { # sha256_of FILE -> hex digest on stdout
	if command -v sha256sum >/dev/null 2>&1; then
		sum=$(sha256sum "$1") || return 1
	elif command -v shasum >/dev/null 2>&1; then
		sum=$(shasum -a 256 "$1") || return 1
	else
		say "neither sha256sum nor shasum is installed"
		return 1
	fi
	printf '%s\n' "${sum%% *}"
}

asset=ubgate_${UBGATE_VERSION#v}_${os}_${arch}.tar.gz
# Downloads land in one fixed directory. Only the files named here are ever
# deleted from it; a leftover from an interrupted run is overwritten next time.
dl=$cache_dir/.download
clean_download() {
	rm -f "$dl/$asset" "$dl/SHA256SUMS" "$dl/ubgate"
	rmdir "$dl" 2>/dev/null || true
}

# install_release: download, verify and unpack the release asset, then move
# the binary into the cache. Returns non-zero, with a message, on failure.
install_release() {
	if [ -z "$os" ] || [ -z "$arch" ]; then
		say "no release build for $(uname -s)/$(uname -m)"
		return 1
	fi
	url=$UBGATE_RELEASE_URL/$UBGATE_VERSION
	say "downloading $url/$asset"
	fetch "$url/$asset" "$dl/$asset" || { say "download failed: $url/$asset"; return 1; }
	fetch "$url/SHA256SUMS" "$dl/SHA256SUMS" || { say "download failed: $url/SHA256SUMS"; return 1; }
	want=$(awk -v f="$asset" '$2 == f || $2 == "*" f { print $1; exit }' "$dl/SHA256SUMS")
	got=$(sha256_of "$dl/$asset") || return 1
	if [ -z "$want" ] || [ "$want" != "$got" ]; then
		say "checksum mismatch for $asset (SHA256SUMS: ${want:-missing}, file: $got); not installed"
		return 1
	fi
	tar -xzf "$dl/$asset" -C "$dl" || { say "could not unpack $asset"; return 1; }
	[ -f "$dl/ubgate" ] || { say "$asset has no ubgate binary"; return 1; }
	chmod +x "$dl/ubgate" && mv -f "$dl/ubgate" "$bin"
}

install_with_go() {
	command -v go >/dev/null 2>&1 || { say "go is not installed"; return 1; }
	say "go install $UBGATE_MODULE@$UBGATE_VERSION"
	GOBIN=$cache_dir go install "$UBGATE_MODULE@$UBGATE_VERSION" && [ -x "$bin" ]
}

mkdir -p "$dl" || die "cannot create $dl"
install_release || install_with_go || {
	clean_download
	die "could not install ubgate $UBGATE_VERSION. Install it yourself (https://github.com/$UBGATE_REPO#install-ubgate) and put it on PATH, or set UBGATE_BIN to its path."
}
clean_download
exec "$bin" "$@"
