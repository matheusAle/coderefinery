#!/bin/sh
# Launcher for the coderefinery skill. Finds or installs the coderefinery
# binary, then runs it with every argument unchanged:
#
#   1. $CODEREFINERY_BIN, when set
#   2. coderefinery on PATH
#   3. the cache: ${XDG_CACHE_HOME:-$HOME/.cache}/coderefinery/<version>/coderefinery
#   4. the release archive for this OS/arch, checked against SHA256SUMS, from
#      coderefinery.dev/dl (Cloudflare R2), else from the GitHub release
#   5. go install .../cmd/coderefinery@<version> into the cache directory
#
# Exit 127 when none of them yields a binary; otherwise coderefinery's own status.
set -eu

# The one place the coderefinery version is pinned. A release tag must match it.
CODEREFINERY_VERSION=v0.1.0
CODEREFINERY_REPO=matheusAle/coderefinery
CODEREFINERY_MODULE=github.com/matheusAle/coderefinery/cmd/coderefinery
# Release downloads, tried in this order; both hold <version>/<archive> and
# <version>/SHA256SUMS. Overridable for mirrors (and for testing against a
# local release dir).
CODEREFINERY_DOWNLOAD_URL=${CODEREFINERY_DOWNLOAD_URL:-https://coderefinery.dev/dl}
CODEREFINERY_RELEASE_URL=${CODEREFINERY_RELEASE_URL:-https://github.com/$CODEREFINERY_REPO/releases/download}

say() { printf 'coderefinery launcher: %s\n' "$*" >&2; }
die() {
	say "$*"
	exit 127
}

if [ -n "${CODEREFINERY_BIN:-}" ]; then
	[ -f "$CODEREFINERY_BIN" ] && [ -x "$CODEREFINERY_BIN" ] || die "CODEREFINERY_BIN=$CODEREFINERY_BIN is not an executable file"
	exec "$CODEREFINERY_BIN" "$@"
fi

# CODEREFINERY_LAUNCHER stops a launcher that is itself on PATH as "coderefinery" from
# calling itself forever.
if [ -z "${CODEREFINERY_LAUNCHER:-}" ] && path_bin=$(command -v coderefinery 2>/dev/null); then
	CODEREFINERY_LAUNCHER=1
	export CODEREFINERY_LAUNCHER
	exec "$path_bin" "$@"
fi

os=
case $(uname -s) in
Darwin) os=darwin ;;
Linux) os=linux ;;
esac
arch=
case $(uname -m) in
x86_64 | amd64) arch=amd64 ;;
arm64 | aarch64) arch=arm64 ;;
esac
[ -n "${XDG_CACHE_HOME:-}" ] || [ -n "${HOME:-}" ] || die "set HOME or XDG_CACHE_HOME (cache location)"
cache_dir=${XDG_CACHE_HOME:-$HOME/.cache}/coderefinery/$CODEREFINERY_VERSION
bin=$cache_dir/coderefinery

if [ -x "$bin" ]; then
	exec "$bin" "$@"
fi

fetch() { # fetch URL FILE
	if command -v curl >/dev/null 2>&1; then
		curl -fsSL --retry 2 -o "$2" "$1"
	elif command -v wget >/dev/null 2>&1; then
		wget -q -O "$2" "$1"
	else
		say "neither curl nor wget is installed"
		return 1
	fi
}

sha256_of() { # sha256_of FILE -> hex digest on stdout
	if command -v sha256sum >/dev/null 2>&1; then
		sum=$(sha256sum "$1") || return 1
	elif command -v shasum >/dev/null 2>&1; then
		sum=$(shasum -a 256 "$1") || return 1
	else
		say "neither sha256sum nor shasum is installed"
		return 1
	fi
	printf '%s\n' "${sum%% *}"
}

asset=coderefinery_${CODEREFINERY_VERSION#v}_${os}_${arch}.tar.gz
# Downloads land in one fixed directory. Only the files named here are ever
# deleted from it; a leftover from an interrupted run is overwritten next time.
dl=$cache_dir/.download
clean_download() {
	rm -f "$dl/$asset" "$dl/SHA256SUMS" "$dl/coderefinery"
	rmdir "$dl" 2>/dev/null || true
}

# install_from BASE_URL: download, verify and unpack the release asset, then
# move the binary into the cache. Returns non-zero, with a message, on failure.
install_from() {
	url=${1%/}/$CODEREFINERY_VERSION
	say "downloading $url/$asset"
	fetch "$url/$asset" "$dl/$asset" || { say "download failed: $url/$asset"; return 1; }
	fetch "$url/SHA256SUMS" "$dl/SHA256SUMS" || { say "download failed: $url/SHA256SUMS"; return 1; }
	want=$(awk -v f="$asset" '$2 == f || $2 == "*" f { print $1; exit }' "$dl/SHA256SUMS")
	got=$(sha256_of "$dl/$asset") || return 1
	if [ -z "$want" ] || [ "$want" != "$got" ]; then
		say "checksum mismatch for $asset (SHA256SUMS: ${want:-missing}, file: $got); not installed"
		return 1
	fi
	tar -xzf "$dl/$asset" -C "$dl" || { say "could not unpack $asset"; return 1; }
	[ -f "$dl/coderefinery" ] || { say "$asset has no coderefinery binary"; return 1; }
	chmod +x "$dl/coderefinery" && mv -f "$dl/coderefinery" "$bin"
}

install_release() {
	if [ -z "$os" ] || [ -z "$arch" ]; then
		say "no release build for $(uname -s)/$(uname -m)"
		return 1
	fi
	install_from "$CODEREFINERY_DOWNLOAD_URL" || install_from "$CODEREFINERY_RELEASE_URL"
}

install_with_go() {
	command -v go >/dev/null 2>&1 || { say "go is not installed"; return 1; }
	say "go install $CODEREFINERY_MODULE@$CODEREFINERY_VERSION"
	GOBIN=$cache_dir go install "$CODEREFINERY_MODULE@$CODEREFINERY_VERSION" && [ -x "$bin" ]
}

mkdir -p "$dl" || die "cannot create $dl"
install_release || install_with_go || {
	clean_download
	die "could not install coderefinery $CODEREFINERY_VERSION. Install it yourself (https://github.com/$CODEREFINERY_REPO#install-coderefinery) and put it on PATH, or set CODEREFINERY_BIN to its path."
}
clean_download
exec "$bin" "$@"
