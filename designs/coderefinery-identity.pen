              "children": [
                {
                  "type": "text",
                  "id": "USQL5",
                  "fill": "$chalk",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Change one token.",
                  "lineHeight": 1.25,
                  "fontFamily": "$font-display",
                  "fontSize": 24,
                  "fontWeight": "700",
                  "letterSpacing": -0.8
                },
                {
                  "type": "text",
                  "id": "F2kHVQ",
                  "fill": "$chalk",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "A site is a token the tool knows how to flip; a mutant is the file with one site changed. Twelve sites in these two functions: `and`, `-`, `0`, `*`, `1`, the comparisons. Each mutant is the smallest bug that can be written.",
                  "lineHeight": 1.45,
                  "fontFamily": "$font-body",
                  "fontSize": 15,
                  "fontWeight": "normal"
                },
                {
                  "type": "frame",
                  "id": "MQLY6",
                  "name": "Heuristic",
                  "width": "fill_container",
                  "stroke": "$seam",
                  "strokeWidth": 1,
                  "gap": 10,
                  "padding": [
                    10,
                    12
                  ],
                  "children": [
